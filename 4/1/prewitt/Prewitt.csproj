<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Prewitt.cs" />
    <Compile Include="$(IntermediateOutputPath)PrewittWrapped.cs" />
  </ItemGroup>
  <Target Name="WrapPrewittSource" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\Prewitt.cs">
      <Output TaskParameter="Lines" ItemName="_PrewittSourceLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_PrewittWrappedLines Include="using System%3B" />
      <_PrewittWrappedLines Include="using System.Drawing%3B" />
      <_PrewittWrappedLines Include="using System.Drawing.Imaging%3B" />
      <_PrewittWrappedLines Include="public static class PrewittFilter" />
      <_PrewittWrappedLines Include="{" />
      <_PrewittWrappedLines Include="@(_PrewittSourceLines)" />
      <_PrewittWrappedLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)PrewittWrapped.cs" Lines="@(_PrewittWrappedLines)" Overwrite="true" />
  </Target>
</Project>
