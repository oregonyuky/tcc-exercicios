<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Sobel.cs" />
    <Compile Include="$(IntermediateOutputPath)SobelWrapped.cs" />
  </ItemGroup>
  <Target Name="WrapSobelSource" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\Sobel.cs">
      <Output TaskParameter="Lines" ItemName="_SobelSourceLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_SobelWrappedLines Include="using System%3B" />
      <_SobelWrappedLines Include="using System.Drawing%3B" />
      <_SobelWrappedLines Include="using System.Drawing.Imaging%3B" />
      <_SobelWrappedLines Include="public static class SobelFilter" />
      <_SobelWrappedLines Include="{" />
      <_SobelWrappedLines Include="@(_SobelSourceLines)" />
      <_SobelWrappedLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)SobelWrapped.cs" Lines="@(_SobelWrappedLines)" Overwrite="true" />
  </Target>
</Project>
